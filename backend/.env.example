# Rename this file to .env and fill in your actual keys.
# 1. Get this from Google AI Studio

GOOGLE_API_KEY=xxx

# 2. Get the connection string from mongoDB Atlas
# Get the MCP Connection String from the "Connect" dialog on your Atlas cluster:
# - Click "Connect" on your cluster in the Atlas UI
# - Select "Connect using MongoDB University" (this exposes the MCP endpoint)
# - Copy the connection string provided
# - Paste it below (replace <password> with your actual password)

MDB_MCP_CONNECTION_STRING="mongodb+srv:...."
